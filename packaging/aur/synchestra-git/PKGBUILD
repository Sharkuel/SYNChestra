# SYNChestra from the latest source on GitHub. For the AUR package synchestra-git.
pkgname=synchestra-git
_name=SYNChestra
pkgver=r0
pkgrel=1
pkgdesc="Record instrument plugins into Decent Sampler, SFZ and Floe libraries"
arch=('x86_64')
url="https://github.com/Sharkuel/SYNChestra"
license=('AGPL-3.0-only')
depends=('alsa-lib' 'freetype2' 'fontconfig' 'libx11' 'libxext' 'libxrandr' 'libxinerama' 'libxcursor')
makedepends=('git' 'cmake' 'ninja')
optdepends=('yabridge: Windows plugins on Linux')
provides=('synchestra')
conflicts=('synchestra')
source=("$_name::git+$url.git"
        "JUCE::git+https://github.com/juce-framework/JUCE.git#tag=8.0.10")
sha256sums=('SKIP' 'SKIP')

pkgver() {
  cd "$_name"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cmake -B build -S "$_name" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DFETCHCONTENT_SOURCE_DIR_JUCE="$srcdir/JUCE"
  cmake --build build --target SYNChestra
}

package() {
  DESTDIR="$pkgdir" cmake --install build --component SYNChestra
}
